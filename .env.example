# Environment Configuration Example
# Copy this file to .env and customize if needed
# Note: This project doesn't require environment variables by default

# ============================================
# Data File Paths (Optional)
# ============================================
# Specify custom paths to your datasets
# Leave empty to use files in the current directory
# DATA_X1_PATH=path/to/your/dataset1.csv
# DATA_X2_PATH=path/to/your/dataset2.csv

# ============================================
# Output Settings (Optional)
# ============================================
# Directory to save output results
# OUTPUT_DIR=./results

# ============================================
# Visualization Settings (Optional)
# ============================================
# Set to 'inline' for Jupyter notebooks, 'default' for standard plots
# PLOT_BACKEND=default

# Maximum number of components to display in detailed plots
# MAX_COMPONENTS_DISPLAY=10

# ============================================
# Streamlit Configuration (Optional)
# ============================================
# Port for Streamlit app (default: 8501)
# STREAMLIT_PORT=8501

# Browser auto-open (true/false)
# STREAMLIT_BROWSER_OPEN=true

# ============================================
# Python Requirements
# ============================================
# This project requires the following packages (install via pip):
# - numpy>=1.21.0
# - pandas>=1.3.0
# - matplotlib>=3.4.0
# - seaborn>=0.11.0
# - scikit-learn>=1.0.0
# - streamlit>=1.20.0
#
# Install all at once:
# pip install -r requirements.txt
